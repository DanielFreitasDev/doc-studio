  "rules": [
    {
      "id": "signature-official-files",
      "page": 22,
      "enforcedBy": "renderer",
      "text": "Nunca altere, recrie ou distorça a marca: só os SVG oficiais de assets/img/ são usados, sempre com a proporção original."
    },
    {
      "id": "signature-joint-order",
      "page": 16,
      "enforcedBy": "renderer",
      "text": "Assinatura conjunta: órgão parceiro à esquerda, Governo à direita, sem fio separador, alinhados pelo centro do escudo (sem a coroa)."
    },
    {
      "id": "signature-protection",
      "page": 15,
      "enforcedBy": "renderer",
      "text": "Área de proteção: em cima e embaixo, 2× a distância entre o brasão e o nome CEARÁ; dos lados, a largura do brasão."
    },
    {
      "id": "signature-minimum",
      "page": 21,
      "enforcedBy": "renderer",
      "text": "Redução mínima: 40 mm de largura com secretaria/órgão; 30 mm sem. Ideal: 50 mm."
    },
    {
      "id": "signature-background",
      "page": 14,
      "enforcedBy": "renderer",
      "text": "Marca sobre fundo branco; em fundo escuro, a versão em negativo."
    },
    {
      "id": "signature-horizontal-first",
      "page": 19,
      "enforcedBy": "renderer",
      "text": "A versão horizontal é a preferida; a vertical só quando o layout não comporta a horizontal."
    },
    {
      "id": "concept-four-lines",
      "page": 9,
      "enforcedBy": "renderer",
      "text": "O conceito “Cuidar das pessoas, avançar o Ceará.” fica sempre ao lado da marca, em quatro linhas, separado por uma linha verde."
    },
    {
      "id": "colors-official",
      "page": 26,
      "enforcedBy": "validator",
      "text": "Cores só da paleta do grafismo (p. 26), da assinatura (p. 11) ou dos tons derivados documentados. Documentos escolhem tons por nome (tema, tom do bloco), nunca por código."
    },
    {
      "id": "typography",
      "page": 10,
      "enforcedBy": "validator",
      "text": "Somente Kanit (títulos) e Maitree (texto corrido); o corpo pode usar Kanit. Exceção funcional: fonte monoespaçada do sistema em comandos e textos de tela (o MIV não define fonte de máquina)."
    },
    {
      "id": "grayscale",
      "page": 12,
      "enforcedBy": "renderer",
      "text": "Para impressão P&B use a escala de cinza do MIV (tabela de correspondência da p. 12), nunca um filtro sobre a página."
    },
    {
      "id": "monochrome-last-resort",
      "page": 13,
      "enforcedBy": "manual",
      "text": "A versão monocromática é último caso; prefira cores ou escala de cinza."
    },
    {
      "id": "text-contrast",
      "page": null,
      "enforcedBy": "validator",
      "text": "Texto em cor sobre o papel precisa de contraste mínimo de 4,5:1 (WCAG AA); por isso os títulos usam os tons escuros."
    },
    {
      "id": "image-resolution",
      "page": null,
      "enforcedBy": "validator",
      "text": "Fotos e prints com pelo menos 150 ppi no tamanho impresso (ideal 300 ppi) para não pixelar no PDF."
    }
  ]
}
